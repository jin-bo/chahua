# 复制成 .env 并填入真实值。.env 在 .gitignore 里。
#
# 也可以把这些变量写在 ~/.env （用户全局），多个 agentao 宿主项目共用。
# 查找顺序：shell export > 项目根 .env > ~/.env。
#
# ── 选哪家 provider ────────────────────────────────────────────────────
# LLM_PROVIDER 决定从哪一组 <PROVIDER>_* 读凭据。未设默认 "openai"。
LLM_PROVIDER=openai

# 采样温度，所有 provider 共用。未设默认 1.0（茶话室是闲聊场景，给得比 agentao
# 自带的 0.2 高些）。要更稳重的回答可以调到 0.3~0.7。
# LLM_TEMPERATURE=1.0

# 已知 provider（自带默认 BASE_URL，不填 *_BASE_URL 也能跑）：
#   openai · deepseek · moonshot · siliconflow · openrouter · ollama
# 其它 provider（含接 Anthropic 自家 API 经 OpenAI-兼容代理）必须显式给 *_BASE_URL。

# ── OpenAI ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ── 其它 provider 示例（按需启用，要配套设 LLM_PROVIDER）──────────────
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-chat

# MOONSHOT_API_KEY=sk-...
# MOONSHOT_MODEL=moonshot-v1-32k

# SILICONFLOW_API_KEY=sk-...
# SILICONFLOW_MODEL=Qwen/Qwen2.5-72B-Instruct

# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# OLLAMA_MODEL=llama3.1
# OLLAMA_BASE_URL=http://localhost:11434/v1   # 默认值，可省
