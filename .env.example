# 复制成 .env 并填入真实值。.env 在 .gitignore 里。
#
# 也可以把这些变量写在 ~/.env （用户全局），多个 agentao 宿主项目共用。
# 查找顺序：shell export > 项目根 .env > ~/.env。
#
# ── 选哪家 provider ────────────────────────────────────────────────────
# LLM_PROVIDER 决定从哪一组 <PROVIDER>_* 读凭据。未设默认 "openai"。
LLM_PROVIDER=openai

# 采样温度，所有 provider 共用。未设默认 1.0（茶话室是闲聊场景，给得比 agentao
# 自带的 0.2 高些）。要更稳重的回答可以调到 0.3~0.7。
# LLM_TEMPERATURE=1.0

# 已知 provider（自带默认 BASE_URL，不填 *_BASE_URL 也能跑）：
#   openai · deepseek · moonshot · siliconflow · openrouter · ollama
# 其它 provider（含接 Anthropic 自家 API 经 OpenAI-兼容代理）必须显式给 *_BASE_URL。

# 端点协议与提示缓存（P21，按 provider 前缀，只对该端点生效）：
#   <PREFIX>_API_FORMAT   = openai-completions（默认）| anthropic-messages | openai-responses
#   <PREFIX>_PROMPT_CACHE = anthropic | off（默认 off；打 Anthropic cache_control 断点）
# 例：直连 Anthropic 并开缓存（第二轮起输入大部分按缓存价计）——
# CLAUDE_API_KEY=sk-ant-...
# CLAUDE_BASE_URL=https://api.anthropic.com/v1
# CLAUDE_MODEL=claude-sonnet-5
# CLAUDE_API_FORMAT=anthropic-messages
# CLAUDE_PROMPT_CACHE=anthropic
# 新一代 OpenAI 模型带工具须走 Responses：OPENAI_API_FORMAT=openai-responses
# 注意：不读 agentao CLI 的全局 LLM_PROMPT_CACHE（切 provider 后会残留到别的端点）。

# ── OpenAI ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ── 其它 provider 示例（按需启用，要配套设 LLM_PROVIDER）──────────────
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-chat

# MOONSHOT_API_KEY=sk-...
# MOONSHOT_MODEL=moonshot-v1-32k

# SILICONFLOW_API_KEY=sk-...
# SILICONFLOW_MODEL=Qwen/Qwen2.5-72B-Instruct

# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# OLLAMA_MODEL=llama3.1
# OLLAMA_BASE_URL=http://localhost:11434/v1   # 默认值，可省
